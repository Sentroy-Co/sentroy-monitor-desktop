<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Outgoing HTTPS to the Sentroy Monitor server. Not sandboxed (direct
       distribution); no camera, microphone, screen or input-monitoring access. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Apple Events to supported browsers, only to read the active tab's address
       when the company records websites (domain only). macOS asks once per browser. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
